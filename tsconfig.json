// It's a configuration file to assist your text editor
// https://www.typescriptlang.org/tsconfig
{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    // Base directory to resolve non-relative module names.
    "baseUrl": ".",
    // path mapping to be computed relative to baseUrl option
    // may use import {func} from 'client/folder', instead of '../../../../folder'
    "types": [
      "vite/client",
      "vitest/globals",
      "@emotion/react/types/css-prop"
    ],
    "noUncheckedIndexedAccess": true,
    "strictNullChecks": true
  },
  // folders and files for providing you with file search, code completion etc...
  "include": [
    "client",
    "server",
    "utils",
    "environment.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "build"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}