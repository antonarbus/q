{
  "include": [
    "*.js",
    "*.jx",
    "*.ts",
    "*.tsx",
    "*.mts",
    "*.mjs",
    "*.cjs",
    "vite.config.mts",
    "front/**/*",
    "back/**/*",
    "tests/**/*",
    "config/**/*",
    "bundle-back/**/*",
    "deploy-scripts/**/*",
    "shared/**/*"
  ],
  "exclude": ["**/node_modules", "**/build", "**/fr.js", "**/froalaPkg.js"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "incremental": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "types": ["bun", "node"],
    "baseUrl": ".",
    "paths": {
      "@app/*": ["./front/app/*"],
      "@page/*": ["./front/page/*"],
      "@widget/*": ["./front/widget/*"],
      "@feature/*": ["./front/feature/*"],
      "@entity/*": ["./front/entity/*"],
      "@shared/*": ["./front/shared/*"],
      "@front/*": ["./front/*"],
      "@back/*": ["./back/*"],
      "@root/*": ["./*"]
    }
  }
}
