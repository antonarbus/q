{
  "name": "quotation.app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=development concurrently \"npm run back\" \"npm run front\"",
    "stop": "kill-port 3005 3006",
    "front": "vite",
    "back": "tsx watch back/index.ts",
    "build_front": "rm -rf ./build/front && vite build",
    "build_back": "rm -rf ./build/back && rollup -c rollup.config.js",
    "build_all": "npm run build_front && npm run build_back",
    "preview_front": "vite preview",
    "preview_back": "node ./build/back/index.js",
    "preview_all": "NODE_ENV=production concurrently \"npm run preview_back\" \"npm run preview_front\"",
    "test": "vitest",
    "test-ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@emotion/css": "^11.11.2",
    "@emotion/styled": "^11.11.5",
    "@formkit/auto-animate": "^0.8.2",
    "@google-cloud/storage": "^7.11.2",
    "@mui/icons-material": "^5.15.20",
    "@mui/material": "^5.15.20",
    "@preact/signals-react": "^2.0.2",
    "@reduxjs/toolkit": "^2.2.5",
    "@sendgrid/mail": "^8.1.3",
    "@tanstack/react-query": "^5.45.1",
    "@tanstack/react-query-devtools": "^5.45.1",
    "ag-grid-react": "^31.3.2",
    "array-move": "^4.0.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "bytes": "^3.1.2",
    "chart.js": "^4.4.3",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "framer-motion": "^11.2.10",
    "froala-editor": "^4.2.1",
    "gsap": "^3.12.5",
    "hamburger-react": "^2.5.1",
    "immer": "^10.1.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.1",
    "jwt-decode": "^4.0.0",
    "lodash.isequal": "^4.5.0",
    "lodash.throttle": "^4.1.1",
    "lodash.uniq": "^4.5.0",
    "mailcheck": "^1.1.1",
    "modern-screenshot": "^4.4.39",
    "mongoose": "^8.4.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "re-resizable": "^6.9.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.23.1",
    "react-toastify": "^10.0.5",
    "react-use": "^17.5.0",
    "round-to": "^6.0.0"
  }
}
