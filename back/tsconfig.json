// https://www.typescriptlang.org/tsconfig#target
{
  "compilerOptions": {
    "target": "ESNext",
    "outDir": "../build/back",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "moduleResolution": "node",
    "noEmit": false,
    "noEmitOnError": false,
    // "baseUrl": ".",
    "paths": {
      "@back/*": [
        "./*"
      ],
      "@app/*": [
        "../front/app/*"
      ],
      "@pages/*": [
        "../front/pages/*"
      ],
      "@widgets/*": [
        "../front/widgets/*"
      ],
      "@features/*": [
        "../front/features/*"
      ],
      "@entities/*": [
        "../front/entities/*"
      ],
      "@shared/*": [
        "../front/shared/*"
      ],
    },
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/client"
  ],
}