// https://www.typescriptlang.org/tsconfig#target
{
  "compilerOptions": {
    "target": "ESNext",
    "outDir": "../build/back",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "moduleResolution": "node",
    "noEmit": true,
    "noEmitOnError": false,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "paths": {
      "@back/*": [
        "./*"
      ],
      "@app/*": [
        "../front/app/*"
      ],
      "@pages/*": [
        "../front/pages/*"
      ],
      "@widgets/*": [
        "../front/widgets/*"
      ],
      "@features/*": [
        "../front/features/*"
      ],
      "@entities/*": [
        "../front/entities/*"
      ],
      "@shared/*": [
        "../front/shared/*"
      ],
      "@lib_instances/*": [
        "../front/lib_instances/*"
      ]
    },
    "types": [
      "vite/client",
      "vitest/globals",
      "@emotion/react/types/css-prop"
    ],
  },
  // "include": [
  //   "index.js"
  // ],
  "include": [
    "**/*.ts",
    "../front/shared/lib/tanstack_query/defaultError.d.ts",
    // "../front/**/*.ts",
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
  ],
}