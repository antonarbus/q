FROM oven/bun:1-alpine AS builder

# Install root dependencies first (needed for build tools like roll-up)
WORKDIR /app
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

# Install backend dependencies (cached unless package files change)
WORKDIR /app/back
COPY back/package.json back/bun.lock* ./
RUN bun install --frozen-lockfile

# Copy rest of the code (this invalidates cache only when code changes)
WORKDIR /app
COPY . .

# Build
RUN bun run build-back

FROM oven/bun:1-alpine
COPY --from=builder /app/back/build /app/back/build
COPY --from=builder /app/back/package.json /app/back/build/package.json
COPY --from=builder /app/back/bun.lock /app/back/build/bun.lock
COPY --from=builder /app/.env /app/back/build/.env
WORKDIR /app/back/build
RUN bun install --frozen-lockfile --production
EXPOSE 4000
ENV INSTALLATION=production
CMD ["bun", "run", "index.js"]
