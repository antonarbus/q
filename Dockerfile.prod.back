FROM oven/bun:1-alpine AS builder

WORKDIR /app

# Copy workspace configuration and package files (cached unless they change)
COPY package.json bun.lock* ./
COPY front/package.json ./front/
COPY back/package.json ./back/

# Install all dependencies (root + workspaces)
RUN bun run install-ci

# Copy rest of the code (this invalidates cache only when code changes)
COPY . .

# Build
RUN bun run build-back

FROM oven/bun:1-alpine

WORKDIR /app

# Copy built backend code
COPY --from=builder /app/back/build ./back/build

# Copy package files for production install
COPY --from=builder /app/package.json ./
COPY --from=builder /app/bun.lock ./
COPY --from=builder /app/back/package.json ./back/
COPY --from=builder /app/config/secrets.ts ./config/secrets.ts

# Install production dependencies (workspaces aware)
RUN bun run install-prod

WORKDIR /app/back/build

EXPOSE 4000
ENV NODE_ENV=production
CMD ["bun", "run", "index.js"]
