{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tests/**/*.spec.ts", "tests/setup/*.ts"]
    },
    "front": {
      "entry": [
        "index.tsx",
        "features/quotation/download-quotation-as-excel/excelWorker.ts",
        "features/quotation/download-quotation-as-pdf/pdfWorker.ts"
      ]
    },
    "back": {
      "entry": ["index.ts"]
    }
  },
  "ignore": [
    "back/shared/lib/drizzle/schema.ts",
    "front/shared/lib/ag-grid/colDef/getNumberColDef.tsx",
    "steiger.config.ts"
  ],
  "ignoreDependencies": ["@feature-sliced/steiger-plugin"],
  "ignoreBinaries": [
    "gcloud",
    "stripe",
    "terraform",
    "open",
    "vite-bundle-visualizer",
    "back/build/index.js"
  ]
}
