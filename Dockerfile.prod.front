FROM oven/bun:1-slim AS builder

WORKDIR /app

# Copy workspace configuration and package files (cached unless they change)
COPY package.json bun.lock* ./
COPY front/package.json ./front/
COPY back/package.json ./back/

# Install all dependencies (root + workspaces)
RUN bun run install-ci

# Copy rest of the code (this invalidates cache only when code changes)
COPY . .

# Build
RUN bun run build-front

FROM nginx:alpine-slim

COPY --from=builder /app/front/build /front/build
RUN chmod -R 755 /front/build/.

# Copy nginx config template (will be processed at runtime)
COPY nginx.conf.template /tmp/nginx.conf.template

# Copy entrypoint script
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80
ENV NODE_ENV=production

# Entrypoint will substitute BACKEND_URL at container startup
ENTRYPOINT ["/docker-entrypoint.sh"]
