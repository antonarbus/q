// https://www.typescriptlang.org/tsconfig#target
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "outDir": "../build_server",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "moduleResolution": "node",
    "include": ["./**/*.ts"],
    "noEmit": false,
    "noEmitOnError": false
  },
  // "include": ["./**/*.ts", "../client/shared/consts/httpStatus.ts"]
}
