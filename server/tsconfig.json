// https://www.typescriptlang.org/tsconfig#target
{
  "compilerOptions": {
    "target": "ESNext",
    // "rootDir": ".",
    "outDir": "../build/server",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      // "@server/*": ["./server/*"],
      // "@client/*": ["./client/*"],
      "@app/*": ["../client/app/*"],
      "@pages/*": ["../client/pages/*"],
      "@widgets/*": ["../client/widgets/*"],
      "@features/*": ["../client/features/*"],
      "@entities/*": ["../client/entities/*"],
      "@shared/*": ["../client/shared/*"],
      "@lib_instances/*": ["client/lib_instances/*"],
    },
  },
  "include": [
    "./**/*.ts",
  ]
}