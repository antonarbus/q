// https://www.typescriptlang.org/tsconfig#target
{
  "compilerOptions": {
    "target": "ESNext",
    "rootDir": ".",
    "outDir": "../build/server",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true
  },
  "include": [
    "./**/*.ts",
  ]
}