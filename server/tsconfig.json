// https://www.typescriptlang.org/tsconfig#target
{
  "compilerOptions": {
    "target": "ESNext",
    "outDir": "../build_server",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "moduleResolution": "node",
    "noEmit": false,
    "noEmitOnError": false,
    "baseUrl": ".",
    "paths": {
      "@server/*": ["../server/*"],
      "@app/*": ["../client/app/*"],
      "@pages/*": ["../client/pages/*"],
      "@widgets/*": ["../client/widgets/*"],
      "@features/*": ["../client/features/*"],
      "@entities/*": ["../client/entities/*"],
      "@shared/*": ["../client/shared/*"],
    },
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "**/node_modules", "**/client"],
}
