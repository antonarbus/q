// https://www.typescriptlang.org/tsconfig#target
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "outDir": "../build/server",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "moduleResolution": "node",
  },
  "include": [
    "./**/*.ts",
  ]
}