{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    // https://github.com/oxc-project/tsgolint is not stable and throws errors
    // Message: Error running tsgolint: "tsgolint process exited with status: exit status: 2
    "typeAware": true // maybe disable for now
  },
  // https://oxc.rs/docs/guide/usage/linter/plugins.html
  "plugins": [
    "eslint",
    "oxc",
    "typescript",
    "unicorn",
    "promise",
    "react",
    "react-perf",
    "jsx-a11y",
    "node",
    "jsdoc",
    "jest",
    "vitest",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "pedantic": "error",
    "suspicious": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  // https://oxc.rs/docs/guide/usage/linter/rules.html
  "rules": {
    "eslint/prefer-destructuring": "off", // direct member access is fine: email = payload.email
    "eslint/arrow-body-style": "off", // allow () => { ... } and () => expression
    "eslint/no-void": "off", // we use `void expr` to explicitly mark ignored promises (no-floating-promises convention); oxlint lacks ESLint's `allowAsStatement` to permit just that
    "eslint/no-warning-comments": "warn", // highlight @todo comments
    "eslint/capitalized-comments": "off", // sometimes comments should start from lower case
    "eslint/id-length": ["error", { "exceptions": ["x", "y", "_"] }], // allow { x: event.clientX, y: event.clientY }
    "eslint/max-lines-per-function": "off", // sometimes long function is better than multiple small functions
    "eslint/max-lines": "off", // inevitable
    "eslint/max-params": "warn", // params of custom functions always put into object, functions from libs we can not control
    "eslint/max-statements": "off", // too strict
    "eslint/no-duplicate-imports": "off", // ? good rule, but not auto-fixable which makes it annoying, check later if it auto-fixable, it is in the roadmap
    "eslint/no-magic-numbers": "off", // ?  good rule, but there is some issue in oxc now, try follow it and explain number where needed
    "eslint/no-ternary": "off", // simple ternary is ok, but nested is not
    "eslint/no-inline-comments": "off", // inline comments are ok
    "eslint/no-undefined": "off", // we technically may re-define window.undefined='hi', but TS will not allow
    "eslint/operator-assignment": ["error", "never"], // i=i+1 instead of i++
    "eslint/sort-imports": "off", // ? not auto-fixable, annoying to sort manually
    "eslint/sort-keys": "off", // not nice, quite often manual sort have mental idea behind
    "eslint/require-unicode-regexp": "off", // do not care about emoji
    "import/exports-last": "off", // types in api handlers are exported and used below
    "import/group-exports": "off", // nah
    "import/no-relative-parent-imports": "off", // ../.. indicates the proximity, for architecture constrains we use dependency-cruiser
    "import/max-dependencies": "off", // strange rule, how we may avoid dependencies
    "import/no-named-export": "off", // only named exports!!!
    "import/no-nodejs-modules": "off", // full stack app, use nodejs modules in back and tooling
    "import/prefer-default-export": "off", // prefer named exports
    "jsdoc/require-param": "off", // not useful with TS
    "jsdoc/require-returns": "off", // not useful with TS
    "jsx-a11y/no-autofocus": "off", // autofocus is intentional and good for ux
    "jest/require-hook": "off", // no jest in use
    "jest/prefer-expect-assertions": "off", // tests have assertions without special directives, too excessive rule
    "oxc/no-async-await": "off", // not interested in compatibility with old browsers
    "oxc/no-optional-chaining": "off", // not interested in compatibility with old browsers
    "oxc/no-rest-spread-properties": "warn", // not interested in compatibility with old browsers
    "react-perf/jsx-no-jsx-as-prop": "off", // react compiler takes care of memoization
    "react-perf/jsx-no-new-array-as-prop": "off", // react compiler takes care of memoization
    "react-perf/jsx-no-new-function-as-prop": "off", // react compiler takes care of memoization
    "react-perf/jsx-no-new-object-as-prop": "off", // react compiler takes care of memoization
    "react/exhaustive-deps": "off", // react compiler handles memoization; rule produces noise for stable refs/dispatch
    "react/jsx-filename-extension": ["error", { "extensions": ["jsx", "tsx"] }], // use .tsx if jsx is inside
    "react/jsx-boolean-value": ["error", "always"], // prop={false} and also prop={true} for consistency
    "react/jsx-max-depth": "off", // too strict
    "react/function-component-definition": [
      "error",
      { "namedComponents": ["function-expression", "arrow-function"] }
    ], // function expression
    "react/jsx-handler-names": "off", // not a good rule, it enforces handleClick, handleChange prop names
    "react/jsx-no-constructed-context-values": "off", // react compiler memoize values
    "react/jsx-no-literals": "off", // no i18n library in this repo, nothing to wrap literals into
    "react/jsx-props-no-spreading": "warn", // like the rule, better to explicitly name props, but in reality we have to spread sometimes
    "react/forbid-component-props": "off", // it forbids 'style' and 'className' props
    "react/no-unknown-property": ["error", { "ignore": ["css"] }], // emotion injects css prop support
    "react/react-compiler": "off", // oxc's reimplementation false-positives heavily on our conventions: refs forwarded via named props (not literally `ref`) get flagged as "accessed during render" even though `.current` is never read, and @preact/signals-react `.value =` assignments get flagged as prop/hook-return mutation; babel-plugin-react-compiler itself still bails out safely at build time on anything it truly can't compile
    "react/react-in-jsx-scope": "off", // not necessary on React 17+
    "node/no-top-level-await": "off", // Bun/ESM-only, `require(esm)` compatibility is not a concern here
    "unicorn/filename-case": ["error", { "cases": { "camelCase": true, "pascalCase": true } }],
    "unicorn/max-nested-calls": "off", // false positives on zod schema and drizzle query builder chains, which are idiomatic fluent nesting
    "unicorn/no-array-for-each": "off", // for...of is faster, but forEach is readable
    "unicorn/prefer-number-coercion": "off", // Number() lacks parseInt/parseFloat's lenient trailing-character behavior, which we rely on for CSS px values (e.g. "500px") and loosely formatted number strings
    "unicorn/no-array-reduce": "off", // for...of is faster, but reduce is readable
    "unicorn/no-null": "off", // DB uses null, DOM APIs use null
    "unicorn/no-useless-undefined": "off", // conflicts with typescript/consistent-return: `return undefined` is required before `return <cleanupFn>` in useEffect early-exits and in mixed-return getters
    "unicorn/prefer-global-this": "off", // window gives typed DOM overloads; globalThis loses KeyboardEvent etc.
    "unicorn/require-post-message-target-origin": "off", // false positive: Worker.postMessage has no targetOrigin parameter
    "vitest/consistent-test-filename": ["error", { "pattern": ".*\\.(test|spec)\\.[tj]sx?$" }],
    "vitest/no-importing-vitest-globals": "off", // imports are required
    "vitest/prefer-importing-vitest-globals": "off", // oxc confuses vitest and playwright
    "vitest/prefer-expect-assertions": "off", // tests have assertions without special directives, too excessive rule
    "vitest/require-hook": "off", // false positive for non-test files
    "typescript/prefer-readonly-parameter-types": "off", // that is fine to be not a readonly
    "typescript/no-unnecessary-boolean-literal-compare": "off", // imho this is better if(someCondition === true) than if(someCondition)
    "typescript/no-inferrable-types": "off", // explicit type annotations are fine even when inferrable
    "typescript/promise-function-async": "off", // conflicts with eslint/require-await + typescript/return-await for pass-through functions that just return a promise directly (no await needed, none allowed outside try/catch) — structurally impossible to satisfy all three at once
    "typescript/consistent-type-definitions": ["error", "type"] // declare types with 'type' keyword
  },
  "overrides": [
    {
      // build tooling runs once as a CLI/build step, not in a request-handling process, so sync fs calls are fine
      "files": ["bundle-back/**", "vite.config.ts"],
      "rules": {
        "node/no-sync": "off"
      }
    },
    {
      // dependency-cruiser only supports CommonJS config files
      "files": [".dependency-cruiser.cjs"],
      "rules": {
        "import/no-commonjs": "off",
        "import/unambiguous": "off"
      }
    }
  ]
}
