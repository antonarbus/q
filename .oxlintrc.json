{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // https://oxc.rs/docs/guide/usage/linter/plugins.html
  "plugins": [
    "eslint",
    "oxc",
    "typescript",
    "unicorn",
    "promise",
    "react",
    "react-perf",
    "jsx-a11y"
    // "import",
    // "jsdoc",
    // "node",
    // "vitest",
    // "jest"
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "pedantic": "error",
    "suspicious": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error"
  },
  // https://oxc.rs/docs/guide/usage/linter/rules.html
  "rules": {
    "eslint/arrow-body-style": "off",
    "eslint/capitalized-comments": "off",
    "eslint/complexity": "off",
    "eslint/id-length": ["error", { "exceptions": ["x", "y"] }],
    "eslint/max-depth": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-lines": "off",
    "eslint/max-params": "off",
    "eslint/max-statements": "off",
    "eslint/no-duplicate-imports": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/no-ternary": "off",
    "eslint/no-undefined": "off", // could re-write the undefined value on window object
    "eslint/operator-assignment": "off",
    "eslint/sort-imports": "off",
    "eslint/sort-keys": "off",
    "import/max-dependencies": "off",
    "import/no-anonymous-default-export": "off",
    "import/no-default-export": "off",
    "import/no-named-export": "off",
    "import/no-nodejs-modules": "off",
    "import/no-unassigned-import": "off",
    "import/prefer-default-export": "off",
    "jest/require-hook": "off",
    "oxc/no-async-await": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "react/jsx-filename-extension": ["error", { "extensions": ["jsx", "tsx"] }],
    "react/jsx-max-depth": "off",
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-type-definitions": ["error", "type"],
    "unicorn/filename-case": ["error", { "cases": { "camelCase": true, "pascalCase": true } }],
    "unicorn/no-array-for-each": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/no-null": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/require-post-message-target-origin": "off",
    "react/no-unknown-property": ["error", { "ignore": ["css"] }],
    "react/exhaustive-deps": "off",
    "react/jsx-props-no-spreading": "off",
    "react-perf/jsx-no-jsx-as-prop": "off", // react compiler takes care of memoization
    "react-perf/jsx-no-new-function-as-prop": "off", // react compiler takes care of memoization
    "react-perf/jsx-no-new-object-as-prop": "off", // react compiler takes care of memoization
    "react-perf/jsx-no-new-array-as-prop": "off" // react compiler takes care of memoization
  }
}
