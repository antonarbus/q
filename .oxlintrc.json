{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "pedantic": "error",
    "suspicious": "error"
  },
  "rules": {
    "max-lines-per-function": "off",
    "eslint/max-depth": "off",
    "eslint/max-lines": "off",
    "unicorn/require-post-message-target-origin": "off"
  }
}
