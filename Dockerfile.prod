FROM oven/bun:1-alpine AS builder

WORKDIR /app

# Copy workspace configuration and package files (cached unless they change)
COPY package.json bun.lock* ./
COPY front/package.json ./front/
COPY back/package.json ./back/

# Install all dependencies (root + workspaces)
RUN bun run install-ci

# Copy rest of the code (this invalidates cache only when code changes)
COPY . .

# Build frontend only (backend runs from TypeScript directly!)
RUN bun run build-front

FROM oven/bun:1-alpine

WORKDIR /app

# Copy backend TypeScript source (no build needed!)
COPY --from=builder /app/back ./back

# Copy built frontend code
COPY --from=builder /app/front/build ./front/build

# Copy config and package files
COPY --from=builder /app/package.json ./
COPY --from=builder /app/bun.lock ./
COPY --from=builder /app/config ./config
COPY --from=builder /app/tsconfig.json ./

# Install backend production dependencies only
RUN cd /app/back && bun install --frozen-lockfile --production

WORKDIR /app

# Port 8080 is the standard for containerized apps and Cloud Run default
EXPOSE 8080
ENV NODE_ENV=production
CMD ["bun", "run", "back/index.ts"]
