http {
  include mime.types;
  sendfile on;
  gzip on;
  client_max_body_size 50M;

  server {
    listen 80;
    server_name _;
    index index.html index.htm;

    # Redirect /blog to /blog/
    location = /blog {
      return 301 /blog/;
    }

    # Serve static blog files
    location /blog/ {
      root /front/build;
      try_files $uri $uri/ =404;

      types {
        text/html html htm;
        text/css css;
        application/javascript js;
      }
    }

    location /api {
      proxy_pass ${BACKEND_URL}; # Forward requests to backend (set via env var at build time)
      proxy_ssl_verify off; # Disable SSL certificate verification (use only for trusted backends)
      proxy_ssl_server_name on; # Enable SNI for proper HTTPS hostname resolution
      proxy_set_header X-Real-IP $remote_addr; # Pass original client IP to backend
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; # Pass full chain of client/proxy IPs
      proxy_set_header X-Forwarded-Proto $scheme; # Pass original protocol (http/https) to backend
    }

    location /uploads {
      proxy_pass ${BACKEND_URL};
      proxy_ssl_verify off;
      proxy_ssl_server_name on;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # React SPA (catch-all for all other routes)
    location / {
      root /front/build/; # <- directory where react bundle is stored
      try_files $uri /index.html; # <- serve index.html for any route
    }
  }
}

events {
  worker_connections 1024;
}
