// https://www.typescriptlang.org/tsconfig
{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    // Base directory to resolve non-relative module names.
    "baseUrl": ".",
    "paths": {
      "@back/*": [
        "../back/*"
      ],
      "@app/*": [
        "./app/*"
      ],
      "@pages/*": [
        "./pages/*"
      ],
      "@widgets/*": [
        "./widgets/*"
      ],
      "@features/*": [
        "./features/*"
      ],
      "@entities/*": [
        "./entities/*"
      ],
      "@shared/*": [
        "./shared/*"
      ],
      "@lib_instances/*": [
        "./lib_instances/*"
      ]
    },
    "types": [
      "vite/client",
      "vitest/globals",
      "@emotion/react/types/css-prop"
    ],
    "noUncheckedIndexedAccess": true,
    "strictNullChecks": true
  },
  // folders and files for providing you with file search, code completion etc...
  // "include": [
  //   // "index.tsx",
  //   // "./",
  //   // "back",
  //   // "utils",
  //   // "front/index.tsx",
  //   // "rollup.config.js"
  // ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    // "vite.config.mts",
    // "build"
  ]
}