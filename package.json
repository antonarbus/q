{
  "name": "quotation.app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "concurrently \"npm run back\" \"npx wait-on http://localhost:3006 && npm run front\"",
    "stop": "npx kill-port 3005 3006",
    "front": "vite",
    "back": "nodemon -L server/server.ts",
    "build_front": "tsc && vite build",
    "build_back": "cp -r ./server ./build  && cd ./server && tsc && cd -",
    "build_all": "npm run build_front && npm run build_back",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "fix": "eslint . --ext .js,.ts,.tsx,.jsx --fix",
    "test": "vitest",
    "test-ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/css": "^11.11.2",
    "@emotion/styled": "^11.11.0",
    "@fvilers/disable-react-devtools": "^1.3.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.20",
    "@reduxjs/toolkit": "^2.0.1",
    "@tanstack/react-query": "^4.36.1",
    "@tanstack/react-query-devtools": "^4.36.1",
    "array-move": "^4.0.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.1",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "framer-motion": "^10.16.15",
    "gsap": "^3.12.3",
    "hamburger-react": "^2.5.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "lodash.isequal": "^4.5.0",
    "mailcheck": "^1.1.1",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "nanoid": "^3.3.4",
    "nodemailer": "^6.9.7",
    "object-hash": "^3.0.0",
    "passive-events-support": "^1.1.0",
    "re-resizable": "^6.9.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-froala-wysiwyg": "^4.1.4",
    "react-icons": "^4.12.0",
    "react-redux": "^9.0.2",
    "react-router-dom": "^6.20.1",
    "react-sortable-hoc": "^2.0.0",
    "react-toastify": "^9.1.3",
    "react-use": "^17.4.2",
    "vite-plugin-babel-macros": "^1.0.6",
    "wait-on": "^7.2.0"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.11.0",
    "@emotion/react": "^11.11.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jquery": "^3.5.29",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash.isequal": "^4.5.8",
    "@types/mailcheck": "^1.1.37",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^6.4.14",
    "@types/object-hash": "^3.0.6",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@types/react-transition-group": "^4.4.10",
    "@types/styled-components": "^5.1.34",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.0.2",
    "c8": "^8.0.1",
    "eslint": "^8.55.0",
    "eslint-config-standard-with-typescript": "^40.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.3.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^23.0.1",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
