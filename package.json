{
  "name": "quotation.app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=development concurrently \"npm run back\" \"npm run front\"",
    "stop": "kill-port 3005 3006",
    "start_front": "vite",
    "start_back": "tsx watch back/index.ts",
    "build_front": "vite build",
    "build_back": "rollup -c rollup.config.js",
    "build_all": "concurrently \"npm run build_front\" \"npm run build_back\"",
    "preview_front": "vite preview",
    "preview_back": "node ./back/build/index.js",
    "preview_all": "NODE_ENV=production concurrently \"npm run preview_back\" \"npm run preview_front\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "tsc": "tsc --noEmit",
    "prettier": "prettier --write .",
    "docker_dev_build": "docker compose -f docker-compose.dev.yml build",
    "docker_dev_up": "docker compose -f docker-compose.dev.yml up",
    "docker_prod_build": "docker compose -f docker-compose.prod.yml build",
    "docker_prod_up": "docker compose -f docker-compose.prod.yml up"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.11.0",
    "@emotion/react": "^11.11.4",
    "@eslint/js": "^9.6.0",
    "@preact/signals-react-transform": "^0.3.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/bytes": "^3.1.4",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jquery": "^3.5.30",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.throttle": "^4.1.9",
    "@types/lodash.uniq": "^4.5.9",
    "@types/mailcheck": "^1.1.37",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-transition-group": "^4.4.10",
    "@types/styled-components": "^5.1.34",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "c8": "^10.1.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.3",
    "globals": "^15.8.0",
    "jsdom": "^24.1.0",
    "kill-port": "^2.0.1",
    "prettier": "3.3.2",
    "rollup": "^4.18.0",
    "rollup-plugin-copy": "^3.5.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.16.0",
    "vite": "^5.3.3",
    "vite-tsconfig-paths": "*",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  }
}
