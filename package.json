{
  "name": "quotation.app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=development concurrently \"npm run back\" \"npm run front\"",
    "stop": "kill-port 3005 3006",
    "front": "vite",
    "back": "tsx watch server/index.ts",
    "build_front": "tsc && rm -r ./build/client && vite build",
    "build_back": "tsc && rm -r ./build/server && rollup -c rollup.config.js",
    "build_all": "tsc && rm -r ./build && vite build && rollup -c rollup.config.js",
    "preview_front": "vite preview",
    "preview_back": "node ./build/server/index.js",
    "preview_all": "NODE_ENV=production concurrently \"npm run preview_back\" \"npm run preview_front\"",
    "lint": "eslint . --ext ts,tsx",
    "fix": "eslint . --ext .js,.ts,.tsx,.jsx --fix",
    "test": "vitest",
    "test-ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
