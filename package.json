{
  "name": "quotation.app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "concurrently \"npm run back\" \"npx wait-on http://localhost:3006 && npm run front\"",
    "stop": "npx kill-port 3005 3006",
    "front": "vite",
    "back": "nodemon -L server/server.ts",
    "build_front": "tsc && vite build",
    "build_back": "cp -r ./server ./build  && cd ./server && tsc && cd -",
    "build_all": "npm run build_front && npm run build_back",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "fix": "eslint . --ext .js,.ts,.tsx,.jsx --fix",
    "test": "vitest",
    "test-ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/css": "^11.11.2",
    "@emotion/styled": "^11.11.0",
    "@formkit/auto-animate": "^1.0.0-beta.6",
    "@fvilers/disable-react-devtools": "^1.3.0",
    "@mui/icons-material": "^5.14.11",
    "@mui/material": "^5.14.11",
    "@reduxjs/toolkit": "^1.9.6",
    "@tanstack/react-query": "^4.35.3",
    "@tanstack/react-query-devtools": "^4.35.3",
    "array-move": "^4.0.0",
    "axios": "^1.5.1",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.0",
    "concurrently": "^8.2.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "framer-motion": "^10.16.4",
    "gsap": "^3.12.2",
    "hamburger-react": "^2.5.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^3.1.2",
    "lodash.isequal": "^4.5.0",
    "mailcheck": "^1.1.1",
    "mongoose": "^7.5.3",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.1",
    "nodemailer": "^6.9.5",
    "object-hash": "^3.0.0",
    "passive-events-support": "^1.1.0",
    "re-resizable": "^6.9.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-froala-wysiwyg": "^4.1.2",
    "react-icons": "^4.11.0",
    "react-redux": "^8.1.2",
    "react-router-dom": "^6.16.0",
    "react-sortable-hoc": "^2.0.0",
    "react-toastify": "^9.1.3",
    "react-use": "^17.4.0",
    "uuid": "^9.0.1",
    "vite-plugin-babel-macros": "^1.0.6",
    "wait-on": "^7.0.1"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.11.0",
    "@emotion/react": "^11.11.1",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/bcryptjs": "^2.4.4",
    "@types/cookie-parser": "^1.4.4",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.18",
    "@types/jquery": "^3.5.19",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/lodash.isequal": "^4.5.6",
    "@types/mailcheck": "^1.1.34",
    "@types/mongoose": "^5.11.97",
