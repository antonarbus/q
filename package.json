{
  "name": "sendmequotation.today",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently \"bun run start-back\" \"bun run start-front\"",
    "stop": "kill-port 3000 4000",
    "start-front": "vite",
    "start-back": "bun --watch back/index.ts",
    "build-front": "NODE_ENV=production ENVIRONMENT=unknown vite build",
    "build-back": "NODE_ENV=production ENVIRONMENT=unknown rollup -c rollup.config.js",
    "build-all": "concurrently \"bun run build-front\" \"bun run build-back\"",
    "install-dev-deps": "bun install",
    "install-front": "bun install --cwd ./front",
    "install-back": "bun install --cwd ./back",
    "install-all": "bun run install-dev-deps && bun run install-front && bun run install-back",
    "preview-front": "ENVIRONMENT=local vite preview",
    "preview-back": "ENVIRONMENT=local bun ./back/build/index.js",
    "preview-all": "concurrently \"bun run preview-back\" \"bun run preview-front\"",
    "unit-test": "NODE_ENV=test vitest run",
    "unit-test-ui": "NODE_ENV=test vitest --ui",
    "e2e-test": "bunx playwright install && playwright test",
    "e2e-test-ui": "bunx playwright install && playwright test --ui",
    "e2e-test-debug": "bunx playwright install && playwright test --debug",
    "e2e-test-record": "bunx playwright install && playwright codegen https://localhost:3000 --ignore-https-errors",
    "tsc": "tsc --noEmit",
    "lint-check": "eslint . --cache --cache-location .eslintcache",
    "lint-check-quiet": "eslint . --cache --cache-location .eslintcache --quiet",
    "lint-fix": "eslint . --fix --cache --cache-location .eslintcache",
    "format-check": "prettier --check . --cache --cache-location .prettiercache",
    "format-fix": "prettier --write . --cache --cache-location .prettiercache",
    "find-unused-files": "knip",
    "find-circular-deps": "bun madge --circular --extensions ts,tsx .",
    "check": "bun run tsc && bun run lint-check-quiet && bun run format-check && bun run unit-test && bun run find-unused-files && bun run find-circular-deps && bun run e2e-test",
    "update-packages-root": "bun update --interactive",
    "update-packages-front": "cd ./front && bun update --interactive",
    "update-packages-back": "cd ./back && bun update --interactive",
    "docker-prod-build": "docker compose -f docker-compose.prod.yml build",
    "docker-prod-start": "docker compose -f docker-compose.prod.yml up & sleep 5 && open http://localhost:80",
    "cli": "bun deploy-scripts/cli.ts",
    "cli-help": "bun deploy-scripts/cli.ts --help"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.39.1",
    "@inquirer/prompts": "^8.0.1",
    "@playwright/test": "1.56.0",
    "@preact/signals-react-transform": "^0.6.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.1.4",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.3.0",
    "@types/bytes": "^3.1.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.throttle": "^4.1.9",
    "@types/lodash.uniq": "^4.5.9",
    "@types/mailcheck": "^1.1.37",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^3.2.4",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "kill-port": "^2.0.1",
    "knip": "^5.65.0",
    "madge": "^8.0.0",
    "prettier": "^3.7.4",
    "rollup": "^4.52.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.1.9",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^3.2.4",
    "zod": "^4.1.13"
  }
}
