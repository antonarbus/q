{
  "name": "sendmequotation.today",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently \"npm run start_back\" \"npm run start_front\"",
    "stop": "kill-port 3000 4000",
    "start_front": "INSTALLATION=local vite",
    "start_back": "INSTALLATION=local tsx watch back/index.ts",
    "build_front": "vite build",
    "build_back": "rollup -c rollup.config.js",
    "build_all": "concurrently \"npm run build_front\" \"npm run build_back\"",
    "install_dev_deps": "npm ci",
    "install_front": "cd ./front && npm ci",
    "install_back": "cd ./back && npm ci",
    "install_all": "npm run install_dev_deps && npm run install_front && npm run install_back",
    "preview_front": "INSTALLATION=local vite preview",
    "preview_back": "INSTALLATION=local node ./back/build/index.js",
    "preview_all": "concurrently \"npm run preview_back\" \"npm run preview_front\"",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "playwright": "INSTALLATION=local playwright test",
    "playwright_ui": "INSTALLATION=local playwright test --ui",
    "playwright_debug": "INSTALLATION=local playwright test --debug",
    "playwright_record": "INSTALLATION=local playwright codegen https://localhost:3000 --ignore-https-errors",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "tsc": "tsc --noEmit",
    "prettier": "prettier . --check",
    "prettier_fix": "prettier --write .",
    "check": "npm run tsc && npm run lint && npm run prettier && npm run test && npm run playwright",
    "fsd": "npx steiger ./front",
    "find_unused_files": "knip",
    "docker_prod_build": "docker compose -f docker-compose.prod.yml build",
    "docker_prod_up": "docker compose -f docker-compose.prod.yml up"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.22.0",
    "@playwright/browser-chromium": "^1.51.0",
    "@playwright/test": "^1.51.0",
    "@preact/signals-react-transform": "^0.5.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/bytes": "^3.1.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jquery": "^3.5.32",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.throttle": "^4.1.9",
    "@types/lodash.uniq": "^4.5.9",
    "@types/mailcheck": "^1.1.37",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-transition-group": "^4.4.12",
    "@types/styled-components": "^5.1.34",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.8",
    "@vitest/ui": "^3.0.8",
    "c8": "^10.1.3",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "kill-port": "^2.0.1",
    "knip": "^5.46.0",
    "prettier": "3.5.3",
    "rollup": "^4.35.0",
    "rollup-plugin-copy": "^3.5.0",
    "steiger": "^0.5.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^3.0.8"
  }
}
