{
  "name": "sendmequotation.today",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "front",
    "back"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev-back\" \"bun run dev-front\"",
    "dev-front": "NODE_ENV=development ENVIRONMENT=local vite",
    "dev-back": "NODE_ENV=development ENVIRONMENT=local bun --watch back/index.ts",
    "stop-dev": "kill-port 3000 3666 8080",
    "stripe-listen": "stripe listen --forward-to localhost:8080/api/stripe/webhook",
    "build-front": "NODE_ENV=production vite build",
    "build-back": "bun run bundle-back/bundleBack.ts",
    "build": "bun run build-front && bun run build-back",
    "bundle-size": "npx vite-bundle-visualizer",
    "install-all": "bun install",
    "install-force": "bun install --force",
    "install-ci": "bun install --frozen-lockfile",
    "install-prod": "bun install --frozen-lockfile --production",
    "preview-front": "NODE_ENV=production ENVIRONMENT=local vite preview",
    "preview-back": "open http://localhost:8080 & NODE_ENV=production ENVIRONMENT=local bun back/build/index.js",
    "preview": "concurrently \"bun run preview-back\" \"bun run preview-front\"",
    "test": "NODE_ENV=test vitest run",
    "test-ui": "NODE_ENV=test vitest --ui",
    "playwright": "bunx playwright install --with-deps && bunx playwright test",
    "playwright-ui": "bunx playwright install && bunx playwright test --ui",
    "playwright-debug": "bunx playwright install && bunx playwright test --debug",
    "playwright-record": "bunx playwright install && bunx playwright codegen https://localhost:3000 --ignore-https-errors",
    "tsc": "tsc --noEmit",
    "lint": "oxlint --quiet",
    "lint-all": "oxlint",
    "lint-fix": "oxlint --fix",
    "lint-rules": "oxlint --rules",
    "fmt": "oxfmt --check",
    "fmt-fix": "oxfmt",
    "knip": "bunx --bun knip",
    "circular": "bun madge --circular --extensions ts,tsx .",
    "fsd": "depcruise front back --config .dependency-cruiser.cjs",
    "terraform-check": "cd terraform && terraform fmt -check -recursive",
    "terraform-format": "cd terraform && terraform fmt -recursive",
    "check": "rm -rf ./back/build/ && bun run fmt && bun run lint && bun run tsc && bun run test && bun run knip && bun run circular && bun run terraform-check && bun run fsd && bun run playwright && bun run build",
    "update-root": "bun update -i --latest",
    "update-front": "cd ./front && bun update -i --latest",
    "update-back": "cd ./back && bun update -i --latest",
    "update-bun": "bun upgrade",
    "docker-build": "docker compose -f docker-compose.prod.yml build",
    "docker-start": "open http://localhost:8080 & docker compose -f docker-compose.prod.yml up",
    "cli": "bun deploy-scripts/cli.ts",
    "cli-help": "bun deploy-scripts/cli.ts --help",
    "db-pull": "bun drizzle-kit pull",
    "db-check": "bun drizzle-kit check",
    "db-generate-migration": "bun drizzle-kit generate",
    "db-migrate-dev": "bun drizzle-kit migrate",
    "db-migrate-test": "ENVIRONMENT=test bun drizzle-kit migrate",
    "db-migrate-prod": "ENVIRONMENT=prod bun drizzle-kit migrate",
    "db-push-dev": "bun drizzle-kit push",
    "db-push-test": "ENVIRONMENT=test bun drizzle-kit push",
    "db-push-prod": "ENVIRONMENT=prod bun drizzle-kit push",
    "db-studio": "bun drizzle-kit studio"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@inquirer/prompts": "^8.5.2",
    "@playwright/test": "1.62.0",
    "@preact/signals-react-transform": "^0.8.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.3.14",
    "@types/bytes": "^3.1.5",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.throttle": "^4.1.9",
    "@types/lodash.uniq": "^4.5.9",
    "@types/mailcheck": "^1.1.37",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.2",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/ui": "^4.1.10",
    "axios": "^1.18.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "concurrently": "^10.0.4",
    "dependency-cruiser": "^18.1.0",
    "drizzle-kit": "^1.0.0-beta.20",
    "esbuild": "^0.28.1",
    "kill-port": "^2.0.1",
    "knip": "^6.29.0",
    "madge": "^8.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "overrides": {
    "prosemirror-model": "^1.25.11"
  }
}
