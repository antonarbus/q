{
  "name": "sendmequotation.today",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently \"npm run start_back\" \"npm run start_front\"",
    "stop": "kill-port 3000 4000",
    "start_front": "INSTALLATION=local vite",
    "start_back": "INSTALLATION=local tsx watch back/index.ts",
    "build_front": "vite build",
    "build_back": "rollup -c rollup.config.js",
    "build_all": "concurrently \"npm run build_front\" \"npm run build_back\"",
    "install_dev_deps": "npm ci",
    "install_front": "cd ./front && npm ci",
    "install_back": "cd ./back && npm ci",
    "install_all": "npm run install_dev_deps && npm run install_front && npm run install_back",
    "preview_front": "INSTALLATION=local vite preview",
    "preview_back": "INSTALLATION=local node ./back/build/index.js",
    "preview_all": "concurrently \"npm run preview_back\" \"npm run preview_front\"",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "playwright": "INSTALLATION=local playwright test",
    "playwright_ui": "INSTALLATION=local playwright test --ui",
    "playwright_debug": "INSTALLATION=local playwright test --debug",
    "playwright_record": "INSTALLATION=local playwright codegen https://localhost:3000 --ignore-https-errors",
    "lint": "eslint .",
    "lint:quite": "eslint . --quiet",
    "lint:cache": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "tsc": "tsc --noEmit",
    "prettier": "prettier . --check",
    "prettier_fix": "prettier --write .",
    "check": "npm run tsc && npm run lint:quite && npm run prettier && npm run test && npm run playwright",
    "fsd": "npx steiger ./front",
    "find_unused_files": "knip",
    "circular_deps": "npx madge --circular front/src/",
    "update:root": "npx npm-check-updates -i",
    "update:front": "npx npm-check-updates -i --cwd ./front",
    "update:back": "npx npm-check-updates -i --cwd ./back",
    "docker_prod_build": "docker compose -f docker-compose.prod.yml build",
    "docker_prod_up": "docker compose -f docker-compose.prod.yml up"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-typescript": "^7.27.1",
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.36.0",
    "@feature-sliced/steiger-plugin": "^0.5.7",
    "@playwright/browser-chromium": "^1.55.1",
    "@playwright/test": "^1.55.1",
    "@preact/signals-react-transform": "^0.6.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/bytes": "^3.1.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jquery": "^3.5.33",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.throttle": "^4.1.9",
    "@types/lodash.uniq": "^4.5.9",
    "@types/lodash.uniqby": "^4.7.9",
    "@types/mailcheck": "^1.1.37",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/react-transition-group": "^4.4.12",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "c8": "^10.1.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "kill-port": "^2.0.1",
    "knip": "^5.64.1",
    "prettier": "3.6.2",
    "rollup": "^4.52.3",
    "rollup-plugin-copy": "^3.5.0",
    "steiger": "^0.5.11",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^3.2.4"
  }
}
