{
  "name": "quotation.app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "concurrently \"npm run back\" \"npm run front\"",
    "stop": "npx kill-port 3005 3006",
    "front": "vite",
    "back": "nodemon -L server/server.ts",
    "build_front": "tsc && vite build",
    "build_back": "cp -r ./server ./build  && cd ./server && tsc && cd -",
    "build_all": "npm run build_front && npm run build_back",
    "preview": "vite preview",
    "lint": "npx eslint . --ext .js,.ts,.tsx,.jsx",
    "fix": "npx eslint . --ext .js,.ts,.tsx,.jsx --fix",
    "test": "vitest",
    "test-ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/css": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@formkit/auto-animate": "^1.0.0-beta.6",
    "@fvilers/disable-react-devtools": "^1.3.0",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.11.8",
    "@reduxjs/toolkit": "^1.9.2",
    "@tanstack/react-query": "^4.24.4",
    "@tanstack/react-query-devtools": "^4.24.4",
    "array-move": "^4.0.0",
    "axios": "^1.3.2",
    "bcryptjs": "^2.4.3",
    "beautiful-react-hooks": "^3.12.2",
    "concurrently": "^7.6.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^6.14.3",
    "framer-motion": "^9.0.2",
    "gsap": "^3.11.4",
    "hamburger-react": "^2.5.0",
    "html-react-parser": "^3.0.8",
    "jsonwebtoken": "^9.0.0",
    "jwt-decode": "^3.1.2",
    "mailcheck": "^1.1.1",
    "mongoose": "^6.9.1",
    "morgan": "^1.10.0",
    "nanoid": "^4.0.1",
    "nodemailer": "^6.9.1",
    "object-hash": "^3.0.0",
    "re-resizable": "^6.9.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.7.1",
    "react-redux": "^8.0.5",
    "react-router-dom": "^6.8.1",
    "react-sortable-hoc": "^2.0.0",
    "react-toastify": "^9.1.1",
    "react-use": "^17.4.0",
    "styled-components": "^5.3.6",
    "uuid": "^9.0.0",
    "vite-plugin-babel-macros": "^1.0.6"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.10.5",
    "@emotion/react": "^11.10.5",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/mailcheck": "^1.1.33",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.4",
    "@types/node": "^18.13.0",
    "@types/nodemailer": "^6.4.7",
    "@types/object-hash": "^3.0.2",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/react-transition-group": "^4.4.5",
    "@types/styled-components": "^5.1.26",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^5.51.0",
    "@typescript-eslint/parser": "^5.51.0",
    "@vitejs/plugin-react": "^3.1.0",
    "@vitest/ui": "^0.28.4",
    "c8": "^7.12.0",
    "eslint": "^8.34.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.6.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.32.2",
    "jsdom": "^21.1.0",
    "nodemon": "^2.0.20",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "vite": "^4.1.1",
    "vite-tsconfig-paths": "*",
    "vitest": "^0.28.4"
  }
