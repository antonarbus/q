{
  "name": "sendmequotation.today",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "front",
    "back"
  ],
  "scripts": {
    "dev": "concurrently \"bun run dev-back\" \"bun run dev-front\"",
    "dev-front": "NODE_ENV=development ENVIRONMENT=local vite",
    "dev-back": "NODE_ENV=development ENVIRONMENT=local bun --watch back/index.ts",
    "stop-dev": "kill-port 3000 3666 8080",
    "build-front": "NODE_ENV=production vite build",
    "build-back": "bun run bundle-back/bundleBack.ts",
    "build": "bun run build-front && bun run build-back",
    "bundle-size": "npx vite-bundle-visualizer",
    "install-all": "bun install",
    "install-ci": "bun install --frozen-lockfile",
    "install-prod": "bun install --frozen-lockfile --production",
    "preview-front": "vite preview",
    "preview": "open http://localhost:8080 & NODE_ENV=production ENVIRONMENT=local bun back/build/index.js",
    "unit-test": "NODE_ENV=test vitest run",
    "unit-test-ui": "NODE_ENV=test vitest --ui",
    "playwright": "bunx playwright install --with-deps && bunx playwright test",
    "playwright-ui": "bunx playwright install && bunx playwright test --ui",
    "playwright-debug": "bunx playwright install && bunx playwright test --debug",
    "playwright-record": "bunx playwright install && bunx playwright codegen https://localhost:3000 --ignore-https-errors",
    "tsc": "tsc --noEmit",
    "lint": "eslint .",
    "lint-quiet": "eslint . --quiet",
    "lint-fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "knip": "bunx --bun knip",
    "circular": "bun madge --circular --extensions ts,tsx .",
    "fsd": "bun steiger ./front",
    "terraform-check": "cd terraform && terraform fmt -check -recursive",
    "terraform-format": "cd terraform && terraform fmt -recursive",
    "check": "bun run tsc && bun run lint-quiet && bun run prettier && bun run unit-test && bun run knip && bun run circular && bun run terraform-check && bun run fsd && bun run playwright && bun run build",
    "update-packages-root": "bun update --interactive",
    "update-packages-front": "cd ./front && bun update --interactive",
    "update-packages-back": "cd ./back && bun update --interactive",
    "update-bun": "bun upgrade",
    "docker-build": "docker compose -f docker-compose.prod.yml build",
    "docker-start": "open http://localhost:8080 & docker compose -f docker-compose.prod.yml up",
    "cli": "bun deploy-scripts/cli.ts",
    "cli-help": "bun deploy-scripts/cli.ts --help",
    "db-pull": "bun drizzle-kit pull",
    "db-check": "bun drizzle-kit check",
    "db-generate": "bun drizzle-kit generate",
    "db-migrate": "bun drizzle-kit migrate",
    "db-push-dev": "bun drizzle-kit push",
    "db-push-test": "ENVIRONMENT=test bun drizzle-kit push",
    "db-push-prod": "ENVIRONMENT=prod bun drizzle-kit push",
    "db-studio": "bun drizzle-kit studio"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.39.1",
    "@feature-sliced/steiger-plugin": "^0.5.7",
    "@inquirer/prompts": "^8.2.0",
    "@playwright/test": "1.58.2",
    "@preact/signals-react-transform": "^0.8.1",
    "@stylistic/eslint-plugin": "^5.8.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.3.9",
    "@types/bytes": "^3.1.5",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.throttle": "^4.1.9",
    "@types/lodash.uniq": "^4.5.9",
    "@types/mailcheck": "^1.1.37",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.2.3",
    "@types/qs": "^6.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^4.0.18",
    "axios": "^1.13.5",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "kill-port": "^2.0.1",
    "knip": "^5.83.1",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "steiger": "^0.5.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  }
}
