{
  "name": "sendmequotation.today",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently \"bun run start_back\" \"bun run start_front\"",
    "stop": "kill-port 3000 4000",
    "start_front": "INSTALLATION=local vite",
    "start_back": "INSTALLATION=local bun --watch back/index.ts",
    "build_front": "vite build",
    "build_back": "rollup -c rollup.config.js",
    "build_all": "concurrently \"bun run build_front\" \"bun run build_back\"",
    "install_dev_deps": "bun install",
    "install_front": "bun install --cwd ./front",
    "install_back": "bun install --cwd ./back",
    "install_all": "bun run install_dev_deps && bun run install_front && bun run install_back",
    "preview_front": "INSTALLATION=local vite preview",
    "preview_back": "INSTALLATION=local bun ./back/build/index.js",
    "preview_all": "concurrently \"bun run preview_back\" \"bun run preview_front\"",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "playwright": "INSTALLATION=local bunx playwright install && playwright test",
    "playwright_ui": "INSTALLATION=local bunx playwright install && playwright test --ui",
    "playwright_debug": "INSTALLATION=local bunx playwright install && playwright test --debug",
    "playwright_record": "INSTALLATION=local bunx playwright install && playwright codegen https://localhost:3000 --ignore-https-errors",
    "tsc": "tsc --noEmit",
    "biome": "biome check",
    "biome:silent": "biome check --diagnostic-level=error",
    "biome:fix": "biome check --fix",
    "check": "bun run tsc && bun run biome:silent && bun run test && bun run playwright",
    "fsd": "bunx steiger ./front",
    "find_unused_files": "knip",
    "circular_deps": "bunx madge --circular front/src/",
    "update:root": "bun update --interactive",
    "update:front": "cd ./front && bun update --interactive",
    "update:back": "cd ./back && bun update --interactive",
    "docker_prod_build": "docker compose -f docker-compose.prod.yml build",
    "docker_prod_up": "docker compose -f docker-compose.prod.yml up"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-typescript": "^7.27.1",
    "@biomejs/biome": "2.2.6",
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@feature-sliced/steiger-plugin": "^0.5.7",
    "@playwright/test": "1.56.0",
    "@preact/signals-react-transform": "^0.6.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.1.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.3.0",
    "@types/bytes": "^3.1.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jquery": "^3.5.33",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.throttle": "^4.1.9",
    "@types/lodash.uniq": "^4.5.9",
    "@types/lodash.uniqby": "^4.7.9",
    "@types/mailcheck": "^1.1.37",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-transition-group": "^4.4.12",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "c8": "^10.1.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "kill-port": "^2.0.1",
    "knip": "^5.65.0",
    "rollup": "^4.52.4",
    "steiger": "^0.5.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^3.2.4"
  }
}
