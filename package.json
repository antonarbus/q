{
  "name": "quotation.app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start_front": "vite",
    "start_back": "nodemon server/server.ts",
    "start_all": "concurrently \"npm run start_back\" \"npm run start_front\"",
    "build_front": "tsc && vite build",
    "build_back": "cp -r ./server ./build  && cd ./server && tsc && cd -",
    "build_all": "npm run build_front && npm run build_back",
    "preview": "vite preview",
    "lint": "npx eslint . --ext .js,.ts,.tsx,.jsx",
    "fix": "npx eslint . --ext .js,.ts,.tsx,.jsx --fix",
    "test": "vitest",
    "test-ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.8.3",
    "axios": "^0.27.2",
    "beautiful-react-hooks": "^3.7.0",
    "concurrently": "^7.2.2",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "gsap": "^3.10.4",
    "hamburger-react": "^2.5.0",
    "jsonwebtoken": "^8.5.1",
    "jwt-decode": "^3.1.2",
    "mongoose": "^6.4.6",
    "morgan": "^1.10.0",
    "nanoid": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.4.0",
    "react-redux": "^8.0.2",
    "react-router-dom": "^6.3.0",
    "react-toastify": "^9.0.7",
    "react-use": "^17.4.0",
    "styled-components": "^5.3.5",
    "vite-plugin-babel-macros": "^1.0.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^14.2.1",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.3",
    "@types/node": "^18.0.6",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@types/react-transition-group": "^4.4.5",
    "@types/styled-components": "^5.1.25",
    "@typescript-eslint/eslint-plugin": "^5.30.6",
    "@typescript-eslint/parser": "^5.30.6",
    "@vitejs/plugin-react": "^2.0.0",
    "@vitest/ui": "^0.18.0",
    "c8": "^7.11.3",
    "eslint": "^8.19.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.2.4",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.30.1",
    "jsdom": "^20.0.0",
    "nodemon": "^2.0.19",
    "ts-node": "^10.9.1",
    "typescript": "^4.7.4",
    "vite": "^3.0.0",
    "vite-tsconfig-paths": "*",
    "vitest": "^0.18.0"
  }
}
